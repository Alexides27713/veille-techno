<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f1115">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Veille">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<title>{{ site_title }}</title>
<style>
  :root {
    --bg: #0f1115;
    --panel: #171a21;
    --panel-2: #1d212a;
    --border: #262b36;
    --text: #e6e8eb;
    --muted: #93a0b3;
    --accent: #5aa9ff;
    --ok: #4cc38a;
    --ko: #ef6b6b;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.55;
  }
  body.locked { overflow: hidden; }
  button, input { font: inherit; color: inherit; }

  /* ---------- Barre du haut ---------- */
  .topbar {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; gap: 14px;
    padding: 12px 18px;
    background: rgba(15, 17, 21, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .burger {
    width: 42px; height: 42px; flex: none;
    display: flex; flex-direction: column; justify-content: center; gap: 5px;
    padding: 0 10px;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    cursor: pointer;
  }
  .burger span {
    display: block; height: 2px; border-radius: 2px; background: var(--text);
    transition: transform .2s, opacity .2s;
  }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .brand h1 { margin: 0; font-size: 1.15rem; line-height: 1.2; }
  .brand .meta { color: var(--muted); font-size: 0.75rem; }
  .current { margin-left: auto; color: var(--muted); font-size: 0.9rem; white-space: nowrap; }

  /* ---------- Menu burger ---------- */
  .overlay {
    position: fixed; inset: 0; z-index: 30;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0; pointer-events: none; transition: opacity .2s;
  }
  .overlay.open { opacity: 1; pointer-events: auto; }
  .drawer {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 40;
    width: min(300px, 85vw);
    background: var(--panel);
    border-right: 1px solid var(--border);
    padding: 18px 12px;
    transform: translateX(-100%); transition: transform .25s ease;
    display: flex; flex-direction: column; gap: 4px;
    overflow-y: auto;
  }
  .drawer.open { transform: translateX(0); }
  .drawer-head {
    padding: 4px 12px 12px;
    font-size: 0.72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted);
  }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    width: 100%; padding: 12px;
    background: transparent; border: 1px solid transparent; border-radius: 10px;
    cursor: pointer; text-align: left;
  }
  .nav-item:hover { background: var(--panel-2); }
  .nav-item.active { background: var(--panel-2); border-color: var(--accent); }
  .nav-item .ico { font-size: 1.2rem; width: 1.6rem; text-align: center; }
  .nav-item .label { flex: 1; }
  .nav-item .count {
    font-size: 0.75rem; color: var(--muted);
    background: var(--bg); border: 1px solid var(--border);
    padding: 1px 8px; border-radius: 999px;
  }

  /* ---------- Contenu ---------- */
  main { max-width: 1200px; margin: 0 auto; padding: 22px 18px 60px; }
  .section { margin-bottom: 40px; }
  .section[hidden] { display: none; }
  .section > h2 {
    display: flex; align-items: baseline; gap: 10px;
    margin: 0 0 16px; font-size: 1.25rem;
    padding-bottom: 8px; border-bottom: 2px solid var(--accent);
  }
  .section > h2 small { color: var(--muted); font-weight: 400; font-size: 0.8rem; }
  .empty { color: var(--muted); padding: 24px 0; }

  .grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  }
  .card {
    display: flex; flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; cursor: pointer;
    transition: transform .15s, border-color .15s, box-shadow .15s;
  }
  .card:hover, .card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    outline: none;
  }
  .thumb {
    position: relative; aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--accent), #20242e 75%);
    overflow: hidden;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .badge {
    position: absolute; left: 10px; bottom: 10px;
    max-width: calc(100% - 20px);
    padding: 3px 10px; border-radius: 999px;
    font-size: 0.72rem;
    background: rgba(15, 17, 21, 0.82); color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .level {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.6rem; font-weight: 800; letter-spacing: .04em;
    color: rgba(15, 17, 21, 0.78);
  }
  .progress {
    position: absolute; right: 10px; top: 10px;
    padding: 3px 10px; border-radius: 999px;
    font-size: 0.72rem; font-weight: 600;
    background: var(--ok); color: #0b0d11;
  }
  .progress[hidden] { display: none; }
  .card .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .card .date { font-size: 0.75rem; color: var(--muted); }
  .card h3 {
    margin: 0; font-size: 1rem; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card p {
    margin: 0; color: var(--muted); font-size: 0.88rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* ---------- Pastilles de thème ---------- */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .chip {
    padding: 6px 14px; border-radius: 999px; cursor: pointer;
    background: var(--panel); border: 1px solid var(--border);
    font-size: 0.85rem; white-space: nowrap;
  }
  .chip span { color: var(--muted); margin-left: 4px; font-size: 0.78rem; }
  .chip:hover { border-color: var(--accent); }
  .chip.active { background: var(--accent); border-color: var(--accent); color: #0b0d11; font-weight: 600; }
  .chip.active span { color: #0b0d11; opacity: .75; }
  .tag {
    align-self: flex-start;
    padding: 2px 9px; border-radius: 999px;
    font-size: 0.72rem; color: var(--text);
    background: var(--panel-2); border: 1px solid var(--border);
  }
  .card[hidden] { display: none; }

  /* ---------- Question du jour ---------- */
  .daily {
    margin: 0 0 20px; padding: 16px 18px;
    background: var(--panel); border: 1px solid var(--border);
    border-left: 4px solid var(--accent); border-radius: var(--radius);
  }
  .daily[hidden] { display: none; }
  .daily-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; font-weight: 700; }
  .daily-head small { color: var(--muted); font-weight: 400; }
  .daily-head .daily-score { margin-left: auto; color: var(--ok); font-weight: 600; }
  .daily .ex .tag { margin-bottom: 8px; display: inline-block; }
  .daily-more { margin-top: 4px; }

  /* exercice « remettre dans l'ordre » */
  .word-line {
    min-height: 52px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    padding: 8px 10px; margin: 0 0 10px; border-radius: 10px;
    background: var(--panel); border: 1px dashed var(--border);
  }
  .word-line .hint { color: var(--muted); font-size: 0.88rem; }
  .word-bank { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 10px; }
  .word {
    padding: 6px 12px; border-radius: 8px; cursor: pointer;
    background: var(--panel); border: 1px solid var(--border);
  }
  .word:hover:not(:disabled) { border-color: var(--accent); }
  .word.placed { background: var(--panel-2); border-color: var(--accent); }
  .word:disabled { cursor: default; }
  .word-line.right { border-color: var(--ok); }
  .word-line.wrong { border-color: var(--ko); }
  .order-actions { display: flex; gap: 8px; }

  /* ---------- Questions (QCM / texte à trous) ---------- */
  .ex { margin: 0 0 18px; padding: 14px 16px; background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px; }
  .ex-q { margin: 0 0 10px; font-weight: 600; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt {
    padding: 8px 14px; border-radius: 10px; cursor: pointer;
    background: var(--panel); border: 1px solid var(--border);
  }
  .opt:hover:not(:disabled) { border-color: var(--accent); }
  .opt:disabled { cursor: default; }
  .opt.right { border-color: var(--ok); background: rgba(76, 195, 138, 0.15); }
  .opt.wrong { border-color: var(--ko); background: rgba(239, 107, 107, 0.15); }
  .fill-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .fill-row input {
    flex: 1; min-width: 160px; padding: 8px 12px; border-radius: 10px;
    background: var(--panel); border: 1px solid var(--border);
  }
  .fill-row input:focus { outline: none; border-color: var(--accent); }
  .fb { margin: 10px 0 0; font-size: 0.9rem; }
  .fb.ok { color: var(--ok); }
  .fb.ko { color: var(--ko); }
  .fb .why { color: var(--muted); }
  .score { margin: 6px 0 12px; font-weight: 600; }

  /* ---------- Fenêtre de résumé / leçon ---------- */
  .modal-backdrop {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(0, 0, 0, 0.7);
    display: none; align-items: center; justify-content: center;
    padding: 18px;
  }
  .modal-backdrop.open { display: flex; }
  .modal {
    position: relative;
    width: min(780px, 100%); max-height: calc(100vh - 36px);
    display: flex; flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--border); border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .modal-close {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(15, 17, 21, 0.85); border: 1px solid var(--border);
    cursor: pointer; font-size: 1.1rem; line-height: 1;
  }
  .modal-close:hover { border-color: var(--accent); }
  .modal-scroll { overflow-y: auto; }
  .modal-img { width: 100%; max-height: 300px; object-fit: cover; display: block; }
  .modal-content { padding: 22px 26px 8px; }
  .modal-meta { color: var(--muted); font-size: 0.8rem; margin-bottom: 8px; }
  .modal-content h2 { margin: 0 0 12px; font-size: 1.35rem; line-height: 1.3; padding-right: 36px; }
  .modal-content p { margin: 0 0 14px; font-size: 0.98rem; }
  .modal-tools { margin: 0 0 14px; }
  .modal-tools[hidden], .modal-note[hidden] { display: none; }
  .modal-note { color: var(--muted); font-size: 0.78rem; font-style: italic; margin: 0 0 18px; }
  .modal-footer {
    padding: 14px 26px 18px;
    border-top: 1px solid var(--border);
    display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap;
  }
  .btn {
    display: inline-block; padding: 9px 16px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--panel-2);
    color: var(--text); text-decoration: none; font-size: 0.9rem; cursor: pointer;
  }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #0b0d11; font-weight: 600; }
  .btn.small { padding: 5px 12px; font-size: 0.82rem; }
  .btn[hidden] { display: none; }

  /* blocs de leçon */
  .blk-h { margin: 22px 0 8px; font-size: 1.05rem; color: var(--accent); }
  .modal-content ul { margin: 0 0 14px; padding-left: 22px; }
  .modal-content li { margin-bottom: 4px; }
  .tip {
    margin: 0 0 14px; padding: 10px 14px; border-radius: 10px;
    background: rgba(240, 180, 41, 0.1); border-left: 3px solid #f0b429;
    font-size: 0.93rem;
  }
  .pair { margin: 0 0 10px; padding: 8px 12px; border-left: 3px solid var(--accent); background: var(--panel-2); border-radius: 0 8px 8px 0; }
  .pair .en { display: block; font-weight: 600; }
  .pair .fr { display: block; color: var(--muted); font-size: 0.9rem; }
  .tablewrap { overflow-x: auto; margin: 0 0 14px; }
  table.lesson { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  table.lesson th, table.lesson td { padding: 7px 10px; border: 1px solid var(--border); text-align: left; }
  table.lesson th { background: var(--panel-2); }
  .lesson-ex-head { margin: 26px 0 6px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 1.15rem; }

  @media (max-width: 560px) {
    .current { display: none; }
    .modal-content { padding: 18px 18px 6px; }
    .modal-footer { padding: 12px 18px 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; scroll-behavior: auto !important; }
  }
  /* iPhone : zones sûres (encoche, barre d'accueil) et pas de zoom au focus */
  body { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); -webkit-text-size-adjust: 100%; }
  header, .topbar { padding-top: env(safe-area-inset-top); }
  input, button { font-size: 16px; }
  button, .card, .chip { -webkit-tap-highlight-color: transparent; }
</style>
</head>
<body>

<header class="topbar">
  <button class="burger" id="burger" type="button"
          aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="drawer">
    <span></span><span></span><span></span>
  </button>
  <div class="brand">
    <h1>{{ site_title }}</h1>
    <div class="meta">Mise à jour : {{ generated_at }}</div>
  </div>
  <div class="current" id="current-title"></div>
</header>

<div class="overlay" id="overlay"></div>

<nav class="drawer" id="drawer" aria-label="Rubriques" aria-hidden="true">
  <div class="drawer-head">Rubriques</div>
  <button class="nav-item active" type="button" data-target="all" style="--accent: #e6e8eb">
    <span class="ico">🗂️</span><span class="label">Tout</span><span class="count">{{ total }}</span>
  </button>
  {% for s in sections %}
  <button class="nav-item" type="button" data-target="{{ s.id }}" style="--accent: {{ s.color }}">
    <span class="ico">{{ s.icon }}</span><span class="label">{{ s.name }}</span><span class="count">{{ s.articles|length }}</span>
  </button>
  {% endfor %}
</nav>

<main>
  {% for s in sections %}
  <section class="section" id="{{ s.id }}" data-name="{{ s.name }}" style="--accent: {{ s.color }}">
    <h2><span>{{ s.icon }}</span> {{ s.name }} <small>{{ s.articles|length }} {% if s.is_english %}leçon{% else %}article{% endif %}{% if s.articles|length > 1 %}s{% endif %}</small></h2>

    {% if s.is_english %}
    <div class="daily" id="daily" hidden>
      <div class="daily-head">
        <span>🎯 Questions du jour</span><small id="daily-date"></small>
        <span class="daily-score" id="daily-score"></span>
      </div>
      <div id="daily-body"></div>
      <button class="btn daily-more" id="daily-more" type="button">Encore 3 questions pour s'entraîner</button>
    </div>
    {% endif %}

    {% if s.topics|length > 1 %}
    <div class="chips" role="group" aria-label="Filtrer par thème">
      <button class="chip active" type="button" data-topic="">Tout <span>{{ s.articles|length }}</span></button>
      {% for t in s.topics %}
      <button class="chip" type="button" data-topic="{{ t.name }}">{{ t.icon }} {{ t.name }} <span>{{ t.count }}</span></button>
      {% endfor %}
    </div>
    {% endif %}

    {% if s.articles %}
    <div class="grid">
      {% for a in s.articles %}
      <article class="card" tabindex="0" role="button" data-id="{{ a.id }}" data-topic="{{ a.topic }}"
               aria-label="Ouvrir : {{ a.title }}">
        <div class="thumb">
          {% if a.image %}<img src="{{ a.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
          {% if a.kind == 'lesson' %}<span class="level">{{ a.level }}</span><span class="progress" hidden></span>{% endif %}
          <span class="badge">{{ a.source }}</span>
        </div>
        <div class="body">
          {% if a.topic %}<span class="tag">{{ a.topic_icon }} {{ a.topic }}</span>{% endif %}
          <div class="date">{{ a.date_label }}{% if a.translated %} · traduit{% endif %}</div>
          <h3>{{ a.title }}</h3>
          {% if a.summary_short %}<p>{{ a.summary_short }}</p>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">Rien pour le moment dans cette rubrique. Relance le script pour la remplir.</p>
    {% endif %}
  </section>
  {% endfor %}
</main>

<div class="modal-backdrop" id="modal-backdrop">
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal-close" id="modal-close" type="button" aria-label="Fermer">✕</button>
    <div class="modal-scroll">
      <img class="modal-img" id="modal-img" alt="" referrerpolicy="no-referrer" hidden>
      <div class="modal-content">
        <div class="modal-meta" id="modal-meta"></div>
        <h2 id="modal-title"></h2>
        <div class="modal-tools" id="modal-tools" hidden>
          <button class="btn small" id="modal-lang" type="button"></button>
        </div>
        <div id="modal-text"></div>
        <div id="modal-lesson"></div>
        <div class="modal-note" id="modal-note"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn" id="modal-close-2" type="button">Fermer</button>
      <a class="btn primary" id="modal-link" href="#" target="_blank" rel="noopener noreferrer">Lire l'article original ↗</a>
    </div>
  </div>
</div>

<script type="application/json" id="articles-data">{{ data|tojson }}</script>
<script type="application/json" id="daily-data">{{ daily|tojson }}</script>
<script>
(function () {
  var DATA = JSON.parse(document.getElementById('articles-data').textContent);
  var DAILY = JSON.parse(document.getElementById('daily-data').textContent);

  var burger = document.getElementById('burger');
  var drawer = document.getElementById('drawer');
  var overlay = document.getElementById('overlay');
  var navItems = document.querySelectorAll('.nav-item');
  var sections = document.querySelectorAll('.section');
  var currentTitle = document.getElementById('current-title');

  var backdrop = document.getElementById('modal-backdrop');
  var modal = document.getElementById('modal');
  var lastFocus = null;
  var current = null;
  var showOriginal = false;

  /* ---------- Petits utilitaires ---------- */
  function store(key, value) { try { localStorage.setItem('veille:' + key, value); } catch (e) {} }
  function load(key) { try { return localStorage.getItem('veille:' + key); } catch (e) { return null; } }

  // texte avec **gras** et *italique* (construit avec des noeuds : pas d'innerHTML)
  function rich(el, text) {
    String(text).split(/(\*\*[^*]+\*\*|\*[^*]+\*)/g).forEach(function (part) {
      if (part.length > 4 && part.slice(0, 2) === '**' && part.slice(-2) === '**') {
        var s = document.createElement('strong');
        s.textContent = part.slice(2, -2);
        el.appendChild(s);
      } else if (part.length > 2 && part.charAt(0) === '*' && part.slice(-1) === '*') {
        var i = document.createElement('em');
        i.textContent = part.slice(1, -1);
        el.appendChild(i);
      } else if (part) {
        el.appendChild(document.createTextNode(part));
      }
    });
  }
  function make(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) { e.className = cls; }
    if (text != null) { rich(e, text); }
    return e;
  }
  function norm(s) {
    return String(s).toLowerCase().replace(/[’‘`´]/g, "'").replace(/\s+/g, ' ').replace(/[.!?]+$/, '').trim();
  }

  /* ---------- Menu burger ---------- */
  function setMenu(open) {
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    drawer.setAttribute('aria-hidden', String(!open));
  }
  burger.addEventListener('click', function () { setMenu(!drawer.classList.contains('open')); });
  overlay.addEventListener('click', function () { setMenu(false); });

  /* ---------- Rubriques ---------- */
  function showSection(target) {
    var found = false;
    sections.forEach(function (sec) {
      var show = target === 'all' || sec.id === target;
      sec.hidden = !show;
      if (show && target !== 'all') { found = true; }
    });
    if (target !== 'all' && !found) { return showSection('all'); }

    var title = 'Toutes les rubriques';
    navItems.forEach(function (btn) {
      var active = btn.dataset.target === target;
      btn.classList.toggle('active', active);
      if (active) { title = btn.querySelector('.label').textContent; }
    });
    currentTitle.textContent = title;
    try { history.replaceState(null, '', target === 'all' ? location.pathname : '#' + target); } catch (e) {}
    window.scrollTo(0, 0);
  }
  navItems.forEach(function (btn) {
    btn.addEventListener('click', function () { showSection(btn.dataset.target); setMenu(false); });
  });

  /* ---------- Blocs de leçon ---------- */
  function renderBlocks(container, blocks) {
    blocks.forEach(function (b) {
      var el = null;
      if (b.type === 'h') { el = make('h3', 'blk-h', b.text); }
      else if (b.type === 'p') { el = make('p', '', b.text); }
      else if (b.type === 'tip') { el = make('div', 'tip', b.text); }
      else if (b.type === 'list') {
        el = document.createElement('ul');
        b.items.forEach(function (it) { el.appendChild(make('li', '', it)); });
      } else if (b.type === 'ex') {
        el = make('div', 'pair');
        el.appendChild(make('span', 'en', b.en));
        el.appendChild(make('span', 'fr', b.fr));
      } else if (b.type === 'table') {
        el = make('div', 'tablewrap');
        var table = make('table', 'lesson');
        var thead = document.createElement('thead');
        var hr = document.createElement('tr');
        b.head.forEach(function (c) { hr.appendChild(make('th', '', c)); });
        thead.appendChild(hr);
        table.appendChild(thead);
        var tbody = document.createElement('tbody');
        b.rows.forEach(function (row) {
          var tr = document.createElement('tr');
          row.forEach(function (c) { tr.appendChild(make('td', '', c)); });
          tbody.appendChild(tr);
        });
        table.appendChild(tbody);
        el.appendChild(table);
      }
      if (el) { container.appendChild(el); }
    });
  }

  /* ---------- Exercices ---------- */
  // QCM : preset = indice déjà choisi (restauration), cb(indice, correct) appelé au clic
  function renderQcm(parent, ex, preset, cb) {
    var opts = make('div', 'opts');
    var fb = make('p', 'fb');
    var buttons = [];
    function choose(i, fromUser) {
      buttons.forEach(function (b, j) {
        b.disabled = true;
        if (j === ex.answer) { b.classList.add('right'); }
        else if (j === i) { b.classList.add('wrong'); }
      });
      var ok = i === ex.answer;
      fb.className = 'fb ' + (ok ? 'ok' : 'ko');
      fb.textContent = '';
      fb.appendChild(document.createTextNode(ok ? '✓ Bien joué. ' : '✗ La bonne réponse : ' + ex.options[ex.answer] + '. '));
      fb.appendChild(make('span', 'why', ex.explain));
      if (cb) { cb(i, ok, fromUser); }
    }
    ex.options.forEach(function (label, i) {
      var b = make('button', 'opt', label);
      b.type = 'button';
      b.addEventListener('click', function () { choose(i, true); });
      buttons.push(b);
      opts.appendChild(b);
    });
    parent.appendChild(opts);
    parent.appendChild(fb);
    if (preset != null) { choose(preset, false); }
  }

  function renderFill(parent, ex, cb) {
    var row = make('div', 'fill-row');
    var input = document.createElement('input');
    input.type = 'text';
    input.autocomplete = 'off';
    input.autocapitalize = 'off';
    input.spellcheck = false;
    input.setAttribute('aria-label', 'Ta réponse');
    var btn = make('button', 'btn', 'Vérifier');
    btn.type = 'button';
    var fb = make('p', 'fb');
    var done = false;
    function check() {
      if (done || !input.value.trim()) { return; }
      done = true;
      var value = norm(input.value);
      var ok = ex.answers.some(function (a) { return norm(a) === value; });
      input.disabled = true; btn.disabled = true;
      fb.className = 'fb ' + (ok ? 'ok' : 'ko');
      fb.textContent = '';
      fb.appendChild(document.createTextNode(ok ? '✓ Correct. ' : '✗ Réponse attendue : ' + ex.answers[0] + '. '));
      fb.appendChild(make('span', 'why', ex.explain));
      if (cb) { cb(ok); }
    }
    btn.addEventListener('click', check);
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); check(); } });
    row.appendChild(input);
    row.appendChild(btn);
    parent.appendChild(row);
    parent.appendChild(fb);
  }

  function renderOrder(parent, ex, cb) {
    var line = make('div', 'word-line');
    var bank = make('div', 'word-bank');
    var actions = make('div', 'order-actions');
    var check = make('button', 'btn', 'Vérifier'); check.type = 'button';
    var clear = make('button', 'btn', 'Effacer'); clear.type = 'button';
    var fb = make('p', 'fb');
    var done = false;
    var chosen = [];
    var indices = ex.words.map(function (_w, i) { return i; });
    for (var tries = 0; tries < 6; tries++) {
      for (var i = indices.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = indices[i]; indices[i] = indices[j]; indices[j] = t;
      }
      if (indices.length < 2 || indices.some(function (v, pos) { return v !== pos; })) { break; }
    }
    function draw() {
      bank.textContent = ''; line.textContent = '';
      indices.forEach(function (wi) {
        if (chosen.indexOf(wi) !== -1) { return; }
        var b = make('button', 'word', ex.words[wi]); b.type = 'button'; b.disabled = done;
        b.addEventListener('click', function () { chosen.push(wi); draw(); });
        bank.appendChild(b);
      });
      chosen.forEach(function (wi) {
        var b = make('button', 'word placed', ex.words[wi]); b.type = 'button'; b.disabled = done;
        b.addEventListener('click', function () { chosen.splice(chosen.indexOf(wi), 1); draw(); });
        line.appendChild(b);
      });
      if (!chosen.length) { line.appendChild(make('span', 'hint', 'Clique sur les mots dans le bon ordre')); }
    }
    check.addEventListener('click', function () {
      if (done) { return; }
      if (chosen.length !== ex.words.length) {
        fb.className = 'fb ko'; fb.textContent = 'Place tous les mots avant de vérifier.'; return;
      }
      done = true;
      var sentence = norm(chosen.map(function (wi) { return ex.words[wi]; }).join(' '));
      var ok = ex.answers.some(function (a) { return norm(a) === sentence; });
      line.classList.add(ok ? 'right' : 'wrong');
      check.disabled = true; clear.disabled = true; draw();
      fb.className = 'fb ' + (ok ? 'ok' : 'ko');
      fb.textContent = '';
      fb.appendChild(document.createTextNode(ok ? '✓ Correct. ' : '✗ Phrase attendue : ' + ex.answers[0] + ' '));
      fb.appendChild(make('span', 'why', ex.explain));
      if (cb) { cb(ok); }
    });
    clear.addEventListener('click', function () { if (!done) { chosen = []; draw(); } });
    actions.appendChild(check); actions.appendChild(clear);
    parent.appendChild(line); parent.appendChild(bank); parent.appendChild(actions); parent.appendChild(fb);
    draw();
  }

  function renderExercises(container, exercises, key) {
    container.textContent = '';
    var answered = 0, correct = 0, finished = false;
    var scoreEl = make('div', 'score');
    container.appendChild(scoreEl);

    function update() {
      scoreEl.textContent = 'Score : ' + correct + ' / ' + exercises.length + (answered === exercises.length ? ' — terminé' : '');
      if (answered === exercises.length && !finished) {
        finished = true;
        var best = parseInt(load(key + ':best') || '-1', 10);
        if (correct > best) { store(key + ':best', String(correct)); best = correct; }
        showProgress(key, best, exercises.length);
        var again = make('button', 'btn', 'Recommencer les exercices');
        again.type = 'button';
        again.addEventListener('click', function () { renderExercises(container, exercises, key); });
        container.appendChild(again);
      }
    }
    function record(ok) { answered += 1; if (ok) { correct += 1; } update(); }

    exercises.forEach(function (ex, i) {
      var box = make('div', 'ex');
      box.appendChild(make('p', 'ex-q', (i + 1) + '. ' + ex.q));
      if (ex.type === 'qcm') { renderQcm(box, ex, null, function (_i, ok) { record(ok); }); }
      else if (ex.type === 'order') { renderOrder(box, ex, record); }
      else { renderFill(box, ex, record); }
      container.appendChild(box);
    });
    update();
  }

  function showProgress(key, best, total) {
    document.querySelectorAll('.card').forEach(function (card) {
      var a = DATA[card.dataset.id];
      if (a && a.kind === 'lesson' && a.lesson_id === key) {
        var el = card.querySelector('.progress');
        if (el) { el.textContent = '✓ ' + best + '/' + total; el.hidden = false; }
      }
    });
  }
  Object.keys(DATA).forEach(function (id) {
    var a = DATA[id];
    if (a.kind === 'lesson') {
      var best = load(a.lesson_id + ':best');
      if (best !== null) { showProgress(a.lesson_id, parseInt(best, 10), a.exercises.length); }
    }
  });

  /* ---------- Question du jour ---------- */
  (function dailyQuestions() {
    var box = document.getElementById('daily');
    if (!box || !DAILY.length) { return; }
    var PER_DAY = 3;
    var now = new Date();
    var day = Math.floor(new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 86400000);
    var body = document.getElementById('daily-body');
    var scoreEl = document.getElementById('daily-score');
    var moreBtn = document.getElementById('daily-more');
    var shown = 0, answered = 0, correct = 0;

    function updateScore() {
      scoreEl.textContent = answered ? (correct + ' / ' + answered + ' bonnes réponses') : '';
    }
    function addQuestion(position, persist) {
      var ex = DAILY[(day * PER_DAY + position) % DAILY.length];
      var wrap = make('div', 'ex');
      if (ex.topic) { wrap.appendChild(make('span', 'tag', ex.topic)); }
      wrap.appendChild(make('p', 'ex-q', ex.q));
      var key = 'daily:' + day + ':' + position;
      var saved = persist ? load(key) : null;
      renderQcm(wrap, ex, saved === null ? null : parseInt(saved, 10), function (i, ok, fromUser) {
        answered += 1;
        if (ok) { correct += 1; }
        if (fromUser && persist) { store(key, String(i)); }
        updateScore();
      });
      body.appendChild(wrap);
    }
    function addSet(persist) {
      for (var k = 0; k < PER_DAY; k++) { addQuestion(shown + k, persist); }
      shown += PER_DAY;
    }
    addSet(true);
    moreBtn.addEventListener('click', function () { addSet(false); });
    document.getElementById('daily-date').textContent =
      now.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
    box.hidden = false;
  })();

  /* ---------- Pastilles de thème ---------- */
  document.querySelectorAll('.chips').forEach(function (chips) {
    var section = chips.closest('.section');
    chips.querySelectorAll('.chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var topic = chip.dataset.topic;
        chips.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('active', c === chip); });
        section.querySelectorAll('.card').forEach(function (card) {
          card.hidden = !!topic && card.dataset.topic !== topic;
        });
      });
    });
  });

  /* ---------- Fenêtre ---------- */
  var elTitle = document.getElementById('modal-title');
  var elText = document.getElementById('modal-text');
  var elLesson = document.getElementById('modal-lesson');
  var elNote = document.getElementById('modal-note');
  var elTools = document.getElementById('modal-tools');
  var elLang = document.getElementById('modal-lang');
  var elLink = document.getElementById('modal-link');
  var elImg = document.getElementById('modal-img');

  function renderModalBody() {
    var a = current;
    var isLesson = a.kind === 'lesson';
    var orig = showOriginal && a.translated;

    elTitle.textContent = orig ? a.title_orig : a.title;
    elText.textContent = '';
    elLesson.textContent = '';

    if (isLesson) {
      elTools.hidden = true;
      elText.appendChild(make('p', '', a.summary_short));
      renderBlocks(elLesson, a.blocks);
      elLesson.appendChild(make('h3', 'lesson-ex-head', 'Exercices'));
      var holder = make('div');
      elLesson.appendChild(holder);
      renderExercises(holder, a.exercises, a.lesson_id);
      elNote.textContent = 'Ta meilleure note est conservée dans ce navigateur.';
    } else {
      var paragraphs = orig ? a.paragraphs_orig : a.paragraphs;
      if (!paragraphs || !paragraphs.length) { paragraphs = [a.summary_short || 'Pas de résumé disponible pour cet article.']; }
      paragraphs.forEach(function (p) { var el = document.createElement('p'); el.textContent = p; elText.appendChild(el); });

      elTools.hidden = !a.translated;
      elLang.textContent = orig ? 'Voir la traduction française' : 'Voir l\'original';
      if (a.translated && !orig) {
        elNote.textContent = 'Résumé automatique traduit en français par traduction automatique : des approximations sont possibles.';
      } else if (orig) {
        elNote.textContent = 'Résumé automatique, dans la langue d\'origine de l\'article.';
      } else {
        elNote.textContent = 'Résumé automatique : les phrases clés de l\'article, dans sa langue d\'origine.';
      }
    }
    elNote.hidden = false;
  }

  function openModal(id, trigger) {
    var a = DATA[id];
    if (!a) { return; }
    lastFocus = trigger || null;
    current = a;
    showOriginal = false;

    var accent = getComputedStyle(trigger.closest('.section')).getPropertyValue('--accent');
    if (accent) { modal.style.borderTopColor = accent.trim(); }

    var meta = a.source + ' · ' + a.date_label;
    if (a.topic && a.kind !== 'lesson') { meta += ' · ' + (a.topic_icon ? a.topic_icon + ' ' : '') + a.topic; }
    document.getElementById('modal-meta').textContent = meta;

    if (a.image) {
      elImg.src = a.image; elImg.hidden = false;
      elImg.onerror = function () { elImg.hidden = true; };
    } else {
      elImg.hidden = true; elImg.removeAttribute('src');
    }

    if (a.link) { elLink.href = a.link; elLink.hidden = false; } else { elLink.hidden = true; }

    renderModalBody();

    backdrop.classList.add('open');
    document.body.classList.add('locked');
    document.querySelector('.modal-scroll').scrollTop = 0;
    document.getElementById('modal-close').focus();
  }

  function closeModal() {
    backdrop.classList.remove('open');
    document.body.classList.remove('locked');
    if (lastFocus) { lastFocus.focus(); }
  }

  elLang.addEventListener('click', function () { showOriginal = !showOriginal; renderModalBody(); });

  document.querySelectorAll('.card').forEach(function (card) {
    card.addEventListener('click', function () { openModal(card.dataset.id, card); });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card.dataset.id, card); }
    });
  });
  document.getElementById('modal-close').addEventListener('click', closeModal);
  document.getElementById('modal-close-2').addEventListener('click', closeModal);
  backdrop.addEventListener('click', function (e) { if (e.target === backdrop) { closeModal(); } });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') { return; }
    if (backdrop.classList.contains('open')) { closeModal(); }
    else if (drawer.classList.contains('open')) { setMenu(false); }
  });

  /* ---------- Démarrage ---------- */
  showSection(location.hash ? location.hash.slice(1) : 'all');
})();
</script>
<script>
if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0) {
  navigator.serviceWorker.register('sw.js').catch(function () {});
}
</script>
</body>
